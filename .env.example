POSTGRES_USER=circle
POSTGRES_PASSWORD=circle_dev_password
POSTGRES_DB=circle
DATABASE_URL=postgresql+psycopg://circle:circle_dev_password@db:5432/circle

# must be a real random value of 32+ characters - the app refuses to start otherwise
# generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_random_string

# the frontend's real origin, for CORS - defaults to the local Vite dev server,
# only needs setting explicitly in a deployed environment
FRONTEND_ORIGIN=http://localhost:5173
